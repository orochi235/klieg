{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "javascript": { "formatter": { "quoteStyle": "single" } },
  "markdown": { "formatter": { "enabled": false } },
  "yaml": { "formatter": { "enabled": false } },
  "linter": { "enabled": true, "rules": { "preset": "recommended" } },
  "overrides": [
    {
      "includes": ["apps/lab/test/**"],
      "linter": { "rules": { "performance": { "useDomNodeTextContent": "off" } } }
    }
  ],
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/.tsbuild",
      "!**/node_modules",
      "!.claude/worktrees",
      "!.superpowers",
      "!**/spikes",
      "!**/test-results",
      "!**/playwright-report"
    ]
  }
}
