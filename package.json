{
  "name": "klieg-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:dist": "vitest run --config vitest.dist.config.ts",
    "test:visual": "playwright test",
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "check": "npm run lint && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "jsdom": "^28.1.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
