{
  "extends": "../../../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "../.tsbuild/tube-lab",
    "paths": {
      "@core/*": ["../../src/*"],
      "@shared/*": ["../shared/*"],
      "@weasel-js/*": ["../../../../../weasel/packages/*/dist/index.d.ts"]
    },
    "rootDir": ".",
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": ["src", "vite.config.ts"],
  "references": [{ "path": "../.." }, { "path": "../shared" }]
}
