{
  "name": "klieg",
  "version": "0.16.6",
  "description": "Shiny extruded 3D type, slammed over the web app you already have, on a transparent WebGL overlay",
  "keywords": [
    "webgl",
    "three",
    "3d",
    "text",
    "animation",
    "overlay",
    "celebration"
  ],
  "homepage": "https://orochi235.github.io/klieg/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orochi235/klieg.git",
    "directory": "packages/core"
  },
  "bugs": "https://github.com/orochi235/klieg/issues",
  "license": "MIT",
  "author": "orochi235",
  "type": "module",
  "sideEffects": [
    "./dist/element.js",
    "./dist/standalone/klieg-sign.js",
    "./src/element.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sign": {
      "types": "./dist/sign/index.d.ts",
      "default": "./dist/sign/index.js"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "default": "./dist/element.js"
    },
    "./element/standalone": "./dist/standalone/klieg-sign.js",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -b tsconfig.json --force && npm run build:standalone",
    "build:standalone": "vite build --config standalone.vite.config.ts",
    "dev:tube-lab": "vite dev/tube-lab",
    "prepack": "npm run build && cp ../../README.md README.md",
    "prepublishOnly": "npm --prefix ../.. run check",
    "dev:kliegsminister": "vite dev/kliegsminister",
    "dev:composition-lab": "vite dev/composition-lab",
    "dev:tube-gallery": "vite dev/tube-gallery"
  },
  "dependencies": {
    "@msb235/blits": "0.6.0",
    "@weasel-js/font": "1.9.0",
    "@weasel-js/text": "1.9.0",
    "opentype.js": "^2.0.0",
    "polygon-clipping": "^0.15.7"
  },
  "peerDependencies": {
    "@types/three": ">=0.185.0 <1.0.0",
    "three": ">=0.185.0 <1.0.0"
  },
  "devDependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@weasel-js/core": "1.9.0",
    "@weasel-js/labkit": "1.9.0",
    "@weasel-js/ui": "1.9.0",
    "codemirror": "^6.0.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "vite": "^8.3.3"
  },
  "peerDependenciesMeta": {
    "@types/three": {
      "optional": true
    }
  }
}
